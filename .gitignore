# Reference sources (development only, not distributed)
sources/
dev_docs/

# Wiki lint scratch output (contributor-side, never committed)
wiki/LINT_REPORT.md

# Python bytecode cache. The renderer scripts suppress it at runtime,
# but py_compile and manual imports still write it.
__pycache__/
*.pyc

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
*.swp
*.swo
*~
.envrc

# Obsidian vault metadata (contributor-side wiki tooling, not plugin content)
.obsidian/

# Local, uncommitted contributor instructions for plugin development
CLAUDE.local.md

# Personal Claude Code harness config (per-user, not plugin content).
# Plugin manifests live under .claude-plugin/ and are committed normally.
# Local .claude state stays ignored, but the committed contributor rules
# under .claude/rules/ track (ignore contents, then re-include rules/,
# because git cannot re-include beneath an ignored directory).
.claude/*
!.claude/rules/