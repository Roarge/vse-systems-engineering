model/core/logical-architecture/  @smart-sensor-demo-owner
model/variations/                 @smart-sensor-demo-owner

# IVV Engineer (IVV)
model/core/verification-validation/  @smart-sensor-demo-owner

# Methodology spec (elevated review per §2.6 rule 4)
methodology/                    @smart-sensor-demo-owner

# Hook configuration: gate dispositions and the test-first record
# (methodology §0.10.4, §11.5). Lowering a gate or changing test_first
# is a tailoring decision, so a human owner reviews it (§11.10).
.iso-config.yaml                @smart-sensor-demo-owner

# Gate logic: the git hooks, the CI workflows, and the story lint with
# the model reader it imports carry the gates the configuration above
# sets, including the Gherkin-first and test-first gates (methodology
# §11.9). A change that weakens one lowers a gate as surely as a
# gate_overrides entry does, so a human owner reviews it (§11.10).
.githooks/                      @smart-sensor-demo-owner
.github/workflows/              @smart-sensor-demo-owner
tools/lint/                     @smart-sensor-demo-owner
tools/render/sysml_model.py     @smart-sensor-demo-owner

# Base Architecture (elevated review per §2.6 rule 4)
model/core/base-architecture/   @smart-sensor-demo-owner
