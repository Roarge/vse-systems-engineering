# Model-derived artefacts under docs/generated/ are committed. The
# renderers regenerate them on model-touching commits (methodology
# section 9.8), and the Contract 3 CI check compares the regenerated
# matrix against the committed copy, which only works when the copy
# is tracked.

# Local-only ISO config overrides
.iso-config.local.yaml

# Generated outputs (not diffable, rebuild from markdown sources)
build/
*.docx
*.pptx
*.pdf

# Python bytecode cache from the tools/render/ scripts
__pycache__/
*.pyc

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Node (if using sysand or other tooling)
node_modules/

# Sensmetry Syside build cache
.syside/
syside.user.toml
